<!--
Local preview-harness copy of SW2GZ\UI\Wizard\WizardWindow.xaml.
Changes vs the original (both forced by the assembly rename to WizardPreview):
  1. `vm` xmlns: dropped the `;assembly=SW2GZ` qualifier so the
     {x:Type vm:*StepViewModel} DataTemplates resolve to THIS assembly.
  2. Theme merged-dictionary pack URI: /SW2GZ;component/UI/Wizard/Theme/...
     -> /WizardPreview;component/Wizard/Theme/SolidWorksTheme.xaml (matches
     the <Link> the theme dictionary lands at in this project).
Keep in sync with the original if the original changes.
-->
<Window x:Class="SW2GZ.UI.Wizard.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wz="clr-namespace:SW2GZ.UI.Wizard"
        xmlns:vm="clr-namespace:SW2GZ.UI.ViewModels"
        Title="SW2GZ — Export to ROS 2 / Gz Sim"
        Width="900" Height="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WizardPreview;component/Wizard/Theme/SolidWorksTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <wz:FractionToPercentConverter x:Key="FractionToPercent" />

            <!-- Map each step VM to its view. -->
            <DataTemplate DataType="{x:Type vm:ModeStepViewModel}">
                <wz:ModeStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TargetsStepViewModel}">
                <wz:TargetsStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OutputStepViewModel}">
                <wz:OutputStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LinksStepViewModel}">
                <wz:LinksStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JointsStepViewModel}">
                <wz:JointsStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CollisionStepViewModel}">
                <wz:CollisionStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialsStepViewModel}">
                <wz:MaterialsStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SensorsStepViewModel}">
                <wz:SensorsStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ControllersStepViewModel}">
                <wz:ControllersStepView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReviewStepViewModel}">
                <wz:ReviewStepView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="12" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="13" Height="13" CornerRadius="2" Background="{DynamicResource BrandBrush}" />
                    <TextBlock Margin="9,0,0,0" Text="SW2GZ" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0" Text="— Export to ROS 2 / Gz Sim"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,11">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="← Back" Style="{DynamicResource GhostButton}"
                            Command="{Binding BackCommand}" />
                    <Button DockPanel.Dock="Right" Content="Next →" Style="{DynamicResource PrimaryButton}"
                            Command="{Binding NextCommand}" />
                    <TextBlock DockPanel.Dock="Right" Margin="0,0,14,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                               Text="{Binding StepCounter}" />
                    <ProgressBar Margin="0,0,14,0" Height="4" Minimum="0" Maximum="100"
                                 Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 Value="{Binding Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
                </DockPanel>
            </Border>

            <!-- Step rail -->
            <Border DockPanel.Dock="Left" Width="212" Background="{DynamicResource Panel2Brush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="8,10">
                    <TextBlock Margin="10,6,10,4" Text="EXPORT STEPS" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,1" Padding="10,8" CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Width="22"
                                                   Text="{Binding IsComplete, Converter={x:Static wz:StepGlyphConverter.Instance}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Active step content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentStep}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
