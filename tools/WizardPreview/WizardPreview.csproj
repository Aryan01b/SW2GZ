  <!--
    ====================================================================
    Wizard XAML views (markup-compiled here so InitializeComponent + the
    named fields resolve). The .xaml.cs code-behind is linked alongside
    each page to form the partial class.

    Exceptions: WizardWindow.xaml and TargetsStepView.xaml reference the
    SW2GZ assembly explicitly (xmlns ...;assembly=SW2GZ and the theme
    pack URI /SW2GZ;component/...). Those two are kept as LOCAL copies
    under .\Wizard\ with the assembly qualifier stripped so the types
    resolve to THIS assembly. Their code-behind is still linked.
    ====================================================================
  -->
  <ItemGroup>
    <!-- Theme dictionary -->
    <Page Include="..\..\SW2GZ\UI\Wizard\Theme\SolidWorksTheme.xaml">
      <Link>Wizard\Theme\SolidWorksTheme.xaml</Link>
    </Page>

    <!-- Converters (WPF, net48-only in the add-in; fine under net8-windows) -->
    <Compile Include="..\..\SW2GZ\UI\Wizard\WizardConverters.cs">
      <Link>Wizard\WizardConverters.cs</Link>
    </Compile>

    <!-- Local (patched) shell + Targets view.
         Their .xaml files live under the project dir and are auto-included
         as <Page> by the SDK; we only link the code-behind here. -->
    <Compile Include="..\..\SW2GZ\UI\Wizard\WizardWindow.xaml.cs">
      <Link>Wizard\WizardWindow.xaml.cs</Link>
