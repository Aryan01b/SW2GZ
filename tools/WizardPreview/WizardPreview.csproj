    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Pure-C# domain/VMs compile cleanly; relax the nullable noise to match the test project -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8612;CS8618;CS8625;CS8767;CA1822;CA1062</NoWarn>
    <!-- Do NOT define SW_INTEROP — SW COM files compile as throwing skeletons -->
    <AssemblyName>WizardPreview</AssemblyName>
    <RootNamespace>WizardPreview</RootNamespace>
  </PropertyGroup>

