P8+ — Step 7 view. One row per link: toggle an override material, name + RGBA
(0..1) or a hex color. REQUIRES VISUAL STUDIO BUILD.
DataContext: MaterialsStepViewModel.
-->
<UserControl x:Class="SW2GZ.UI.Wizard.MaterialsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wz="clr-namespace:SW2GZ.UI.Wizard">
    <UserControl.Resources>
        <wz:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel Margin="22,20">
        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource H2}" Text="Materials" />
        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Hint}"
                   Text="Attach an optional override color to each link (RGBA 0..1 or hex)." />

        <Border BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" CornerRadius="6">
            <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="11,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                              IsChecked="{Binding UseMaterial}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Text="{Binding LinkName}" />
                                </DockPanel>
                                <StackPanel Margin="26,6,0,0"
                                            Visibility="{Binding UseMaterial, Converter={StaticResource BoolToVis}}">
                                    <DockPanel Margin="0,2">
                                        <TextBlock Width="86" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" Text="Name" />
                                        <TextBox Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Width="86" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" Text="Hex" />
                                        <TextBox Style="{DynamicResource Mono}"
                                                 Text="{Binding HexColor, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                    <Grid Margin="86,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                            <TextBlock Style="{DynamicResource FieldLabel}" Text="R" />
                                            <TextBox Text="{Binding R, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <TextBlock Style="{DynamicResource FieldLabel}" Text="G" />
                                            <TextBox Text="{Binding G, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0">
                                            <TextBlock Style="{DynamicResource FieldLabel}" Text="B" />
                                            <TextBox Text="{Binding B, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="3,0,0,0">
                                            <TextBlock Style="{DynamicResource FieldLabel}" Text="A" />
                                            <TextBox Text="{Binding A, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</UserControl>
