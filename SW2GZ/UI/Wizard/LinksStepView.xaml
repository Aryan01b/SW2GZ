P8 — Step 4 view. Link tree (left) + selected-link properties / assign
geometry (right). REQUIRES VISUAL STUDIO BUILD. DataContext: LinksStepViewModel.
-->
<UserControl x:Class="SW2GZ.UI.Wizard.LinksStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wz="clr-namespace:SW2GZ.UI.Wizard">
    <UserControl.Resources>
        <wz:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel Margin="22,20">
        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource H2}" Text="Links &amp; meshes" />
        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Hint}"
                   Text="Select a link, then pick its geometry in the SolidWorks viewport." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <!-- Link tree -->
            <Border Grid.Column="0" Margin="0,0,6,0" BorderThickness="1"
                    BorderBrush="{DynamicResource LineBrush}" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel2Brush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="11,7">
                        <TextBlock Text="Link tree" FontWeight="SemiBold" FontSize="11.5" />
                    </Border>
                    <ListBox BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource OkBrush}"
                                               FontSize="11" Text="✓ geometry"
                                               Visibility="{Binding HasGeometry, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Selected link properties -->
            <Border Grid.Column="1" Margin="6,0,0,0" BorderThickness="1"
                    BorderBrush="{DynamicResource LineBrush}" CornerRadius="6"
                    DataContext="{Binding SelectedLink}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel2Brush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="11,7">
                        <TextBlock FontWeight="SemiBold" FontSize="11.5"
                                   Text="{Binding Name, StringFormat='Selected · {0}', FallbackValue='No link selected'}" />
                    </Border>
                    <StackPanel Margin="9,8">
                        <DockPanel Margin="0,4">
                            <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Link name" />
                            <TextBlock Style="{DynamicResource Mono}" HorizontalAlignment="Right" Text="{Binding Name}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Mass (from SW)" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding MassKg, StringFormat='{}{0:0.###} kg'}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Visual mesh" />
                            <TextBlock Style="{DynamicResource Mono}" HorizontalAlignment="Right" Text="{Binding VisualMeshFile}" />
                        </DockPanel>

                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="6"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Geometry" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           Text="{Binding SelectedBodyCount, StringFormat='{}{0} bodies assigned'}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Assign selected" Style="{DynamicResource PrimaryButton}"
                                            Command="{Binding AssignGeometryCommand}" />
                                    <Button Content="Clear" Margin="8,0,0,0" Style="{DynamicResource DefaultButton}"
                                            Command="{Binding ClearGeometryCommand}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource OkBrush}" FontWeight="SemiBold"
                                           FontSize="12" Text="✓ Geometry assigned"
                                           Visibility="{Binding HasGeometry, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
