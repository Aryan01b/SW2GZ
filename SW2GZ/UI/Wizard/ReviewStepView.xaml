P8 — Step 5 view. Summary + Finish export. REQUIRES VISUAL STUDIO BUILD.
DataContext: ReviewStepViewModel.
-->
<UserControl x:Class="SW2GZ.UI.Wizard.ReviewStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="22,20">
        <TextBlock Style="{DynamicResource H2}" Text="Review &amp; export" />
        <TextBlock Style="{DynamicResource Hint}" Text="Pre-flight validation runs before any file is written." />

        <StackPanel MaxWidth="430" HorizontalAlignment="Left">
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Mode" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding ModeSummary}" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Target" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding TargetSummary}" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Package" />
                <TextBlock Style="{DynamicResource Mono}" HorizontalAlignment="Right" Text="{Binding PackageName}" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Links / joints" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LinkCount}" />
                    <TextBlock Text=" / " />
                    <TextBlock Text="{Binding JointCount}" />
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Geometry" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding AssignedGeometryCount}" />
                    <TextBlock Text=" / " />
                    <TextBlock Text="{Binding LinkCount}" />
                    <TextBlock Text=" links assigned" />
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Collision" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding CollisionSummary}" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Materials" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding MaterialCount, StringFormat='{}{0} override(s)'}" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Sensors" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding SensorCount}" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Controller" />
                <TextBlock Style="{DynamicResource Mono}" HorizontalAlignment="Right" Text="{Binding ControllerSummary}" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Validation" />
                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource OkBrush}" FontWeight="SemiBold"
                           Text="{Binding ValidationErrorCount, StringFormat='{}{0} errors'}" />
            </DockPanel>
        </StackPanel>

        <Button Margin="0,18,0,0" HorizontalAlignment="Left" Content="Finish export"
                Style="{DynamicResource PrimaryButton}"
                Command="{Binding FinishExportCommand}" />
    </StackPanel>
</UserControl>
