P8 — Step 3 view. Output folder (Browse) + package name with live sanitize
preview. REQUIRES VISUAL STUDIO BUILD. DataContext: OutputStepViewModel.
-->
<UserControl x:Class="SW2GZ.UI.Wizard.OutputStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="22,20">
        <TextBlock Style="{DynamicResource H2}" Text="Output" />
        <TextBlock Style="{DynamicResource Hint}" Text="Where the workspace is written and the package name." />

        <StackPanel Margin="0,0,0,15" MaxWidth="430" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource FieldLabel}" Text="OUTPUT FOLDER" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Browse…"
                        Style="{DynamicResource DefaultButton}"
                        Command="{Binding BrowseCommand}" />
                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </StackPanel>

        <StackPanel MaxWidth="430" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource FieldLabel}" Text="PACKAGE NAME" />
            <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{DynamicResource Hint}" Margin="0" Text="Sanitized live to " />
                <TextBlock Style="{DynamicResource Mono}" Text="{Binding SanitizedPackageName}" />
                <TextBlock Style="{DynamicResource Hint}" Margin="0" Text=" — valid ROS/ament name." />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
