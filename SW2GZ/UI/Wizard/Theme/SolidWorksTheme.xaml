P8 — SolidWorks-aligned theme. Light + dark brush sets matching
docs/ui-mockups/wizard-flow-v2.html. The wizard binds via DynamicResource so
the dark set can be swapped in at runtime when IThemeService reports dark.

REQUIRES VISUAL STUDIO BUILD — the WPF markup compiler is not available in the
headless build environment. Verified visually in VS, not by dotnet build.

To switch to dark at runtime, merge SolidWorksTheme.Dark.xaml's keys over the
defaults below (left as a follow-up; light is the v2.1 default).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Light palette (default) — mirrors :root in the mockup ===== -->
    <Color x:Key="BgColor">#FFEEF0F3</Color>
    <Color x:Key="ChromeColor">#FFE4E7EB</Color>
    <Color x:Key="PanelColor">#FFFFFFFF</Color>
    <Color x:Key="Panel2Color">#FFF7F8FA</Color>
    <Color x:Key="InkColor">#FF23272E</Color>
    <Color x:Key="MutedColor">#FF6C7178</Color>
    <Color x:Key="LineColor">#FFD4D8DE</Color>
    <Color x:Key="Line2Color">#FFE4E7EB</Color>
    <Color x:Key="AccentColor">#FF1B6EC2</Color>
    <Color x:Key="AccentSoftColor">#FFE8F1FB</Color>
    <Color x:Key="OkColor">#FF1D7A46</Color>
    <Color x:Key="BrandColor">#FFD42A2A</Color>

    <SolidColorBrush x:Key="BgBrush"         Color="{DynamicResource BgColor}" />
    <SolidColorBrush x:Key="ChromeBrush"     Color="{DynamicResource ChromeColor}" />
    <SolidColorBrush x:Key="PanelBrush"      Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="Panel2Brush"     Color="{DynamicResource Panel2Color}" />
    <SolidColorBrush x:Key="InkBrush"        Color="{DynamicResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush"      Color="{DynamicResource MutedColor}" />
    <SolidColorBrush x:Key="LineBrush"       Color="{DynamicResource LineColor}" />
    <SolidColorBrush x:Key="Line2Brush"      Color="{DynamicResource Line2Color}" />
    <SolidColorBrush x:Key="AccentBrush"     Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="OkBrush"         Color="{DynamicResource OkColor}" />
    <SolidColorBrush x:Key="BrandBrush"      Color="{DynamicResource BrandColor}" />

    <!-- ===== Shared text styles ===== -->
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="DefaultButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Padding" Value="7,5" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Padding" Value="7,5" />
    </Style>

</ResourceDictionary>
