<UserControl x:Class="SW2GZ.UI.Wizard.CollisionStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="22,20">
        <TextBlock Style="{DynamicResource H2}" Text="Collision" />
        <TextBlock Style="{DynamicResource Hint}"
                   Text="How the collision mesh is derived from each link's visual geometry." />

        <StackPanel MaxWidth="430" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource FieldLabel}" Text="COLLIDER STRATEGY" />
            <ComboBox ItemsSource="{Binding StrategyOptions}"
                      SelectedItem="{Binding SelectedStrategy}" />
            <Border Margin="0,10,0,0" Padding="10" CornerRadius="6"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" Text="{Binding StrategyDescription}" />
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
