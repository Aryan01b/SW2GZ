P8+ — Step 9 view. ros2_control selection: always-on joint_state_broadcaster
plus a primary controller pick. REQUIRES VISUAL STUDIO BUILD.
DataContext: ControllersStepViewModel.
-->
<UserControl x:Class="SW2GZ.UI.Wizard.ControllersStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="22,20">
        <TextBlock Style="{DynamicResource H2}" Text="Controllers" />
        <TextBlock Style="{DynamicResource Hint}"
                   Text="Pick the ros2_control controllers spawned for this robot." />

        <StackPanel MaxWidth="460" HorizontalAlignment="Left">
            <CheckBox Margin="0,4,0,0" IsChecked="{Binding JointStateBroadcaster, Mode=OneWay}"
                      IsEnabled="False" Content="joint_state_broadcaster (required)" />
            <TextBlock Style="{DynamicResource Hint}" Text="{Binding BroadcasterNote}" />

            <TextBlock Margin="0,14,0,0" Style="{DynamicResource FieldLabel}" Text="PRIMARY CONTROLLER" />
            <ComboBox ItemsSource="{Binding ControllerOptions}"
                      SelectedItem="{Binding SelectedController}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{DynamicResource Hint}" Margin="0" Text="Resolves to " />
                <TextBlock Style="{DynamicResource Mono}" Text="{Binding ControllerName}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
