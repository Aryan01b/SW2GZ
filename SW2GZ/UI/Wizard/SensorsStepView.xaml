P8+ — Step 8 view (the dedicated sensors page). Master list (add/remove) +
detail panel: kind, attached link, pose (xyz + rpy in the ROS/Gz frame),
topic, gz_frame_id, update rate, and kind-specific params shown via the
ShowXxxFields flags. The 3D axis preview is deferred; AxisReadout gives a
text forward/up summary instead. REQUIRES VISUAL STUDIO BUILD.
DataContext: SensorsStepViewModel.
-->
<UserControl x:Class="SW2GZ.UI.Wizard.SensorsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wz="clr-namespace:SW2GZ.UI.Wizard">
    <UserControl.Resources>
        <wz:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel Margin="22,20">
        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource H2}" Text="Sensors" />
        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Hint}"
                   Text="Add sensors and assign them to links. Poses are in the ROS/Gz frame." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- Master list + add/remove -->
            <Border Grid.Column="0" Margin="0,0,6,0" BorderThickness="1"
                    BorderBrush="{DynamicResource LineBrush}" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel2Brush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="11,7">
                        <DockPanel>
                            <TextBlock VerticalAlignment="Center" Text="Sensors" FontWeight="SemiBold" FontSize="11.5" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Add" Style="{DynamicResource PrimaryButton}"
                                        Command="{Binding AddSensorCommand}" />
                                <Button Content="Remove" Margin="6,0,0,0" Style="{DynamicResource DefaultButton}"
                                        Command="{Binding RemoveSensorCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Margin="11,6" FontSize="11" Foreground="#D9822B"
                               Text="Duplicate sensor names present."
                               Visibility="{Binding HasDuplicateNames, Converter={StaticResource BoolToVis}}" />
                    <ListBox BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" Text="{Binding Kind}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail panel -->
            <Border Grid.Column="1" Margin="6,0,0,0" BorderThickness="1"
                    BorderBrush="{DynamicResource LineBrush}" CornerRadius="6"
                    DataContext="{Binding SelectedSensor}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10">
                        <TextBlock Style="{DynamicResource FieldLabel}" Text="NAME" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{DynamicResource FieldLabel}" Text="KIND" />
                                <ComboBox ItemsSource="{Binding SensorKindOptions}" SelectedItem="{Binding Kind}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Style="{DynamicResource FieldLabel}" Text="ATTACHED LINK" />
                                <ComboBox ItemsSource="{Binding DataContext.AvailableLinks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding AttachedLink}" IsEditable="True" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,10,0,0" Style="{DynamicResource FieldLabel}" Text="POSE (ROS/Gz frame) — XYZ" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,3,0" Text="{Binding PoseX, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="1" Margin="3,0" Text="{Binding PoseY, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Margin="3,0,0,0" Text="{Binding PoseZ, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" Style="{DynamicResource FieldLabel}" Text="RPY (roll/pitch/yaw, radians)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,3,0" Text="{Binding PoseRoll, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="1" Margin="3,0" Text="{Binding PosePitch, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Margin="3,0,0,0" Text="{Binding PoseYaw, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <TextBlock Margin="0,5,0,0" Style="{DynamicResource Mono}" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" Text="{Binding AxisReadout}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{DynamicResource FieldLabel}" Text="TOPIC" />
                                <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Style="{DynamicResource FieldLabel}" Text="GZ FRAME ID" />
                                <TextBox Text="{Binding GzFrameId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource FieldLabel}" Text="UPDATE RATE (Hz)" />
                        <TextBox Text="{Binding UpdateRate, UpdateSourceTrigger=LostFocus}" />

                        <!-- IMU -->
                        <StackPanel Visibility="{Binding ShowImuFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,8,0,0" Style="{DynamicResource FieldLabel}" Text="GAUSSIAN NOISE STDDEV" />
                            <TextBox Text="{Binding GaussianNoiseStdDev, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <!-- GpuLidar -->
                        <StackPanel Visibility="{Binding ShowLidarFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,8,0,0" Style="{DynamicResource FieldLabel}" Text="HORIZONTAL SAMPLES" />
                            <TextBox Text="{Binding HorizontalSamples, UpdateSourceTrigger=LostFocus}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{DynamicResource FieldLabel}" Text="MIN ANGLE (rad)" />
                                    <TextBox Text="{Binding HorizontalMinAngle, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{DynamicResource FieldLabel}" Text="MAX ANGLE (rad)" />
                                    <TextBox Text="{Binding HorizontalMaxAngle, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{DynamicResource FieldLabel}" Text="RANGE MIN (m)" />
                                    <TextBox Text="{Binding RangeMin, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{DynamicResource FieldLabel}" Text="RANGE MAX (m)" />
                                    <TextBox Text="{Binding RangeMax, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Camera / DepthCamera -->
                        <StackPanel Visibility="{Binding ShowCameraFields, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{DynamicResource FieldLabel}" Text="WIDTH" />
                                    <TextBox Text="{Binding Width, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{DynamicResource FieldLabel}" Text="HEIGHT" />
                                    <TextBox Text="{Binding Height, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,6,0,0" Style="{DynamicResource FieldLabel}" Text="HORIZONTAL FOV (rad)" />
                            <TextBox Text="{Binding HorizontalFovRad, UpdateSourceTrigger=LostFocus}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{DynamicResource FieldLabel}" Text="NEAR CLIP (m)" />
                                    <TextBox Text="{Binding NearClip, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{DynamicResource FieldLabel}" Text="FAR CLIP (m)" />
                                    <TextBox Text="{Binding FarClip, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ForceTorque -->
                        <StackPanel Visibility="{Binding ShowForceTorqueFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,8,0,0" Style="{DynamicResource Hint}"
                                       Text="Force/torque sensors attach to a joint (pose ignored)." />
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="CHILD JOINT NAME" />
                            <TextBox Text="{Binding ChildJointName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Contact -->
                        <StackPanel Visibility="{Binding ShowContactFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,8,0,0" Style="{DynamicResource Hint}"
                                       Text="Contact sensors monitor a named collision element." />
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="COLLISION NAME" />
                            <TextBox Text="{Binding CollisionName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Navsat -->
                        <StackPanel Visibility="{Binding ShowNavsatFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,8,0,0" Style="{DynamicResource FieldLabel}" Text="GAUSSIAN NOISE STDDEV" />
                            <TextBox Text="{Binding GaussianNoiseStdDev, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
